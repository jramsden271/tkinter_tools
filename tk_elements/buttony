import tkinter as tk

class RoundedButton(tk.Canvas):
    def __init__(self, parent, width, height, radius, color, text, command=None):
        super().__init__(parent, borderwidth=0, highlightthickness=0, bg=parent["bg"])
        self.command = command
        self.config(width=width, height=height)
        
        # Draw the rounded shape
        self.draw_rounded_rect(0, 0, width, height, radius, color)
        
        # Add the text label
        self.create_text(width/2, height/2, text=text, fill="white", font=("Arial", 10, "bold"))
        
        # Bind click events
        self.bind("<ButtonPress-1>", self._on_press)
        self.bind("<ButtonRelease-1>", self._on_release)

    def draw_rounded_rect(self, x, y, w, h, r, color):
        # We draw 4 arcs (corners) and 2 rectangles (body)
        # Top-left, Top-right, Bottom-right, Bottom-left
        self.create_arc(x, y, x+2*r, y+2*r, start=90, extent=90, fill=color, outline=color)
        self.create_arc(w-2*r, y, w, y+2*r, start=0, extent=90, fill=color, outline=color)
        self.create_arc(w-2*r, h-2*r, w, h, start=270, extent=90, fill=color, outline=color)
        self.create_arc(x, h-2*r, x+2*r, h, start=180, extent=90, fill=color, outline=color)
        
        # Fill the gaps between arcs
        self.create_rectangle(x+r, y, w-r, h, fill=color, outline=color)
        self.create_rectangle(x, y+r, w, h-r, fill=color, outline=color)

    def _on_press(self, event):
        pass
        #self.configure(alpha=0.5) # Optional: visual feedback

    def _on_release(self, event):
        if self.command:
            self.command()